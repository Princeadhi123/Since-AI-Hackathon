# Configuration read by the app. Copy to .env (git-ignored) to set these
# locally; the app loads .env at startup and process env always wins.
# Only the keys below are read - everything else in .env is ignored.
#
# Provider selection: LLM_PROVIDER is 'aitta' or 'openai'. Switching provider
# requires a compatible LLM_MODEL AND the matching credential - an OpenAI
# key is never sent to Aitta and an Aitta token is never sent to OpenAI.
LLM_PROVIDER=aitta
# CSC/LUMI Aitta token (event access; get yours at https://aitta-auth.csc.fi/myToken)
AITTA_API_TOKEN=
LLM_MODEL=openai/gpt-oss-120b
# OpenAI alternative: LLM_PROVIDER=openai, LLM_MODEL=gpt-4.1-mini, plus:
OPENAI_API_KEY=
DEMO_DATA_DIR=data/demo_v1
RUNTIME_DB_PATH=var/runtime.sqlite
