# Configuration read by the app. Copy to a new local .env (git-ignored),
# or merge settings into an existing file without overwriting credentials.
# The app loads .env at startup and process env always wins.
# Only the keys below are read - everything else in .env is ignored.
#
# Provider selection: LLM_PROVIDER is 'aitta', 'openai', 'featherless' or
# 'snowflake'. Switching provider requires a compatible LLM_MODEL AND the
# matching credential - a key is never sent to a different provider.
LLM_PROVIDER=snowflake
# CSC/LUMI Aitta token (event access; get yours at https://aitta-auth.csc.fi/myToken)
AITTA_API_TOKEN=
LLM_MODEL=claude-sonnet-4-6
# OpenAI alternative: LLM_PROVIDER=openai, LLM_MODEL=gpt-4.1-mini, plus:
OPENAI_API_KEY=
# Featherless AI alternative (hackathon credit; OpenAI-compatible):
# LLM_PROVIDER=featherless, LLM_MODEL=<a model id from their catalog>, plus:
FEATHERLESS_API_KEY=
# Snowflake Cortex alternative (OpenAI-compatible REST; PAT auth):
# LLM_PROVIDER=snowflake, LLM_MODEL=claude-sonnet-4-6, plus:
# SNOWFLAKE_ACCOUNT_HOST=YOUR_ORG-YOUR_ACCOUNT.snowflakecomputing.com
# SNOWFLAKE_PAT=
DEMO_DATA_DIR=data/demo_v1
RUNTIME_DB_PATH=var/runtime.sqlite
SNOWFLAKE_ACCOUNT_HOST=TNRTNCL-SX96827.snowflakecomputing.com
SNOWFLAKE_PAT=
